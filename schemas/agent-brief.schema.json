{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://priv8-ai.example/schemas/vuln-arena-agent-brief-v1.json",
  "title": "Vuln Arena answer-free agent brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["lab_id", "rules", "reporting", "targets"],
  "properties": {
    "lab_id": {"type": "string", "minLength": 1},
    "rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "reporting": {
      "type": "object",
      "required": ["schema_version", "format", "required_finding_fields", "entry_point_fields"],
      "properties": {
        "schema_version": {"const": "2.0"},
        "format": {"type": "string"},
        "required_finding_fields": {"type": "array", "items": {"type": "string"}},
        "entry_point_fields": {"type": "array", "items": {"type": "string"}}
      }
    },
    "targets": {
      "type": "array",
      "minItems": 44,
      "maxItems": 44,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "stack", "base_url"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "stack": {"type": "string", "minLength": 1},
          "base_url": {"type": "string", "pattern": "^http://127\\.0\\.0\\.1:18[0-9]{3}$"}
        }
      }
    }
  }
}
