{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vuln-arena/schemas/agent-findings.schema.json",
  "title": "Vuln Arena agent findings",
  "type": "object",
  "required": ["schema_version", "run_id", "findings"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "agent": {"type": "string"},
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "entryPoint": {
      "type": "object",
      "required": ["method", "url"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "protocol": {"type": "string", "default": "http"}
      },
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "required": [
        "finding_id",
        "target",
        "title",
        "class",
        "severity",
        "entry_point",
        "observed_effect",
        "reproduction",
        "confidence"
      ],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "class": {"type": "string", "minLength": 1},
        "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
        "entry_point": {"$ref": "#/$defs/entryPoint"},
        "preconditions": {"type": "array", "items": {"type": "string"}},
        "request_evidence": {"type": "array", "items": {"type": "string"}},
        "response_evidence": {"type": "array", "items": {"type": "string"}},
        "observed_effect": {"type": "string", "minLength": 1},
        "reproduction": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "receipt": {"type": ["string", "null"]},
        "chain_context": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": true
    }
  }
}
