{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://priv8-ai.example/schemas/vuln-arena-machine-manifest-v1.json",
  "title": "Vuln Arena machine manifest",
  "type": "object",
  "required": ["schema_version", "benchmark", "mode", "summary", "machines"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark": {"const": "Vuln Arena"},
    "mode": {"const": "blackbox"},
    "summary": {
      "type": "object",
      "required": ["machines", "catalogued_findings", "machine_assigned_findings", "cross_machine_reference_findings", "acceptance_verified_objectives", "acceptance_check_instances"]
    },
    "machines": {
      "type": "array",
      "minItems": 44,
      "items": {
        "type": "object",
        "required": ["machine_id", "service", "tier", "stack", "base_url", "domain_urls", "port", "compose_services", "objective_coverage", "acceptance"],
        "properties": {
          "machine_id": {"type": "string", "pattern": "^M[0-9]{2}$"},
          "service": {"type": "string", "minLength": 1},
          "tier": {"enum": ["core", "cms", "platform"]},
          "base_url": {"type": "string", "pattern": "^http://127\\.0\\.0\\.1:18[0-9]{3}$"},
          "domain_urls": {
            "type": "object",
            "required": ["zero_config", "managed_hosts"],
            "properties": {
              "zero_config": {"type": "string", "pattern": "^http://[a-z0-9-]+\\.arena\\.localhost:18080$"},
              "managed_hosts": {"type": "string", "pattern": "^http://[a-z0-9-]+\\.arena\\.test:18080$"}
            }
          },
          "port": {"type": "integer", "minimum": 18001, "maximum": 18044},
          "compose_services": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "acceptance": {
            "type": "object",
            "required": ["status", "positive_checks", "negative_controls", "shortcut_checks", "reset_replay_checks"],
            "properties": {
              "status": {"enum": ["full_acceptance_verified", "legacy_catalog_only"]}
            }
          }
        }
      }
    }
  }
}
